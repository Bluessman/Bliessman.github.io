<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Pendaftaran Server Minecraft</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family: Arial, sans-serif;
    }

    body{
      background:#111;
      color:white;
      display:flex;
      justify-content:center;
      align-items:center;
      min-height:100vh;
      padding:20px;
      background-image: linear-gradient(to bottom right, #1b1b1b, #0f3d0f);
    }

    .container{
      width:100%;
      max-width:500px;
      background:#1e1e1e;
      border:3px solid #3cff3c;
      border-radius:12px;
      padding:30px;
      box-shadow:0 0 20px rgba(60,255,60,0.3);
    }

    h1{
      text-align:center;
      margin-bottom:25px;
      color:#3cff3c;
    }

    .form-group{
      margin-bottom:18px;
    }

    label{
      display:block;
      margin-bottom:8px;
      font-weight:bold;
    }

    input{
      width:100%;
      padding:12px;
      border:none;
      border-radius:8px;
      outline:none;
      background:#2a2a2a;
      color:white;
      font-size:15px;
    }

    input:focus{
      border:2px solid #3cff3c;
    }

    button{
      width:100%;
      padding:14px;
      background:#3cff3c;
      color:black;
      border:none;
      border-radius:8px;
      font-size:16px;
      font-weight:bold;
      cursor:pointer;
      transition:0.2s;
    }

    button:hover{
      background:#2fe62f;
      transform:scale(1.02);
    }

    .success-box{
      display:none;
      margin-top:25px;
      padding:20px;
      background:#0f2d0f;
      border:2px solid #3cff3c;
      border-radius:10px;
      line-height:1.8;
    }

    .success-box h2{
      color:#3cff3c;
      margin-bottom:10px;
    }

    .server-info{
      background:#161616;
      padding:12px;
      border-radius:8px;
      margin:10px 0;
    }

    .warning{
      color:#ffd54f;
      font-weight:bold;
    }

    @media(max-width:600px){
      .container{
        padding:20px;
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <h1>Form Pendaftaran Server Minecraft</h1>

    <form id="mcForm">

      <div class="form-group">
        <label>Nama Lengkap</label>
        <input type="text" id="nama" required>
      </div>

      <div class="form-group">
        <label>Nomor HP</label>
        <input 
          type="tel" 
          id="hp" 
          pattern="[0-9]+" 
          title="Hanya angka"
          required>
      </div>

      <div class="form-group">
        <label>Gamertag Minecraft</label>
        <input type="text" id="gamertag" required>
      </div>

      <div class="form-group">
        <label>Umur</label>
        <input type="number" id="umur" required>
      </div>

      <button type="submit">Daftar Sekarang</button>

    </form>

    <div class="success-box" id="successBox">

      <h2>Pendaftaran Berhasil!</h2>

      <p>Silakan masuk ke server menggunakan data berikut:</p>

      <div class="server-info">
        <strong>IP Server:</strong> play.serverkamu.my.id <br>
        <strong>Port:</strong> 19132
      </div>

      <p class="warning">
        Wajib konfirmasi ke admin sebelum bermain agar akun dapat diverifikasi.
      </p>

      <br>

      <p>
        <strong>Hubungi Admin:</strong><br>
        Discord: discord.gg/serverkamu <br>
        WhatsApp: 08xxxxxxxxxx
      </p>

    </div>

  </div>

  <script>
    const form = document.getElementById("mcForm");
    const successBox = document.getElementById("successBox");

    form.addEventListener("submit", function(e){
      e.preventDefault();

      const hp = document.getElementById("hp").value;

      // Validasi hanya angka
      if(!/^[0-9]+$/.test(hp)){
        alert("Nomor HP hanya boleh angka!");
        return;
      }

      form.style.display = "none";
      successBox.style.display = "block";
    });
  </script>

</body>
</html>
